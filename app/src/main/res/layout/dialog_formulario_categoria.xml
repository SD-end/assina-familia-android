<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollFormularioCategoria"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutFormularioCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/txtRotuloNomeCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dica_nome_categoria"
            android:textColor="@color/cor_texto_primario"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNomeCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/cor_borda_sutil"
            app:counterEnabled="true"
            app:counterMaxLength="100"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNomeCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dica_nome_categoria_placeholder"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1"
                android:textColor="@color/cor_texto_primario"
                android:textColorHint="@color/cor_texto_apoio" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/txtRotuloDescricaoCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dica_descricao_categoria"
            android:textColor="@color/cor_texto_primario"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescricaoCategoria"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/cor_borda_sutil"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDescricaoCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/dica_descricao_categoria_placeholder"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300"
                android:maxLines="4"
                android:minLines="2"
                android:textColor="@color/cor_texto_primario"
                android:textColorHint="@color/cor_texto_apoio" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
